<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-hosted servers on a home network are often plain http
  (e.g. http://192.168.1.20:5550), so cleartext is allowed here. The app only
  accepts an http:// server address when the host is a local-network address
  (Config.normalizeOrigin / isLocalHost); every server on the internet still
  has to use HTTPS. Android can't scope cleartext to IP ranges in this file,
  which is why the check lives in code.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
