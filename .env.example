# ─────────────────────────────────────────────────────────────────────────────
# Zekktris — example environment file
#
# The easy way: run the installer from the repo root. It works out how this
# machine is reachable (a domain, just your public IP, or your home network),
# opens the router ports it can, writes this file with fresh secrets, and
# starts everything:
#
#   ./install.sh
#
# To do it by hand instead:
#
#   cp .env.example .env
#   # Replace these placeholders with strong random values:
#   #   DB_PASSWORD        = openssl rand -hex 24
#   #   JWT_SECRET         = openssl rand -hex 32
#   #   JWT_REFRESH_SECRET = openssl rand -hex 32   (must differ from JWT_SECRET)
#   docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── Public URL ───────────────────────────────────────────────────────────────
# Where users will reach the app. Caddy uses this as the site address — if
# it's https://, Caddy auto-provisions a Let's Encrypt cert. If it's http://
# or localhost, Caddy stays plaintext.
#
# This MUST include the port that matches HTTP_PORT below (or HTTPS_PORT for
# https://). Caddy parses PUBLIC_URL to decide what port to listen on inside
# the container, and the docker-compose mapping wires the same port through
# to the host.
#
# Examples:
#   http://localhost:5550            (LAN-only, no domain — the default)
#   http://zekktris.local:5550       (LAN with mDNS)
#   https://zekktris.com:5551        (public, Caddy provisions a cert via
#                                     ACME — see the TLS section in README;
#                                     port 80 must also be reachable for the
#                                     HTTP-01 challenge. If Cloudflare is
#                                     in front, set the CF proxy mode to
#                                     "DNS only" / grey-cloud OR put
#                                     Cloudflare in "Full (strict)" SSL
#                                     mode so Caddy can present its cert.)
PUBLIC_URL=http://localhost:5550

# ── Serving address (Caddy) ───────────────────────────────────────────────────
# SITE_ADDRESS decides how the proxy actually serves the app. This is separate
# from PUBLIC_URL (which only feeds outgoing links like emails/invites).
#   - Default ":5550"                  → listen on HTTP_PORT for any host (LAN)
#   - "https://chat.example.com"       → serve that domain with automatic HTTPS
#                                        (Let's Encrypt); set HTTP_PORT=80 and
#                                        HTTPS_PORT=443 below, open 80+443, and
#                                        point the domain's DNS at this host.
# Leave at the default if an edge proxy (Cloudflare Tunnel, nginx, …) already
# terminates TLS and forwards to this host:5550.
#
# No domain? Serve the public IP itself with a free Let's Encrypt IP
# certificate (6-day certificates, renewed automatically):
#   SITE_ADDRESS=https://203.0.113.5   PUBLIC_URL=https://203.0.113.5
#   TLS_MODE=ip   PUBLIC_IP=203.0.113.5   HTTP_PORT=80   HTTPS_PORT=443
#   COOKIE_SECURE=true
# and forward TCP 80 + 443 on the router to this machine.
SITE_ADDRESS=:5550

# TLS mode: "none" (default) or "ip" (see above, and ops/caddy-modes/README).
TLS_MODE=none
# The public IP, only used when TLS_MODE=ip.
PUBLIC_IP=

# What sits in front of Caddy, which decides whose word Caddy takes for the
# visitor's IP address (rate limits, IP bans, audit log and sessions use it):
#   none        (default) Caddy is the edge — every ./install.sh mode. The
#               address is the TCP peer; no request header can change it.
#   cloudflare  ONLY when all outside traffic comes through Cloudflare
#               (orange-cloud DNS or a Cloudflare Tunnel). Caddy then trusts
#               Cloudflare and the Docker bridge range and reads
#               Cf-Connecting-Ip. Set it anywhere else and visitors who reach
#               Caddy from those ranges can pick their own address.
# EDGE_PROXY=none

# Optional contact for ACME registration. Helps with cert renewal warnings.
# ACME_EMAIL=you@example.com

# ── Host ports ───────────────────────────────────────────────────────────────
# Ports Caddy listens on. They're used both inside the container and on the
# host (the compose mapping is N:N). For LAN use the 5550-5551 default avoids
# conflicting with anything else commonly running on a server. To serve a real
# domain with HTTPS, set these to 80 and 443 (and set SITE_ADDRESS above).
HTTP_PORT=5550
HTTPS_PORT=5551

# ── Data directory ───────────────────────────────────────────────────────────
# Where Postgres data, Caddy certs, and uploaded attachments live on disk.
# Default is the unraid appdata path — fresh unraid deployments need no edit
# here. For local development or non-unraid hosts, change this to something
# under your home directory (e.g. ./data inside this repo, or ~/zekktris-data).
APPDATA_PATH=/mnt/user/appdata/zekktris

# ── Database ─────────────────────────────────────────────────────────────────
# This password is what Postgres uses for the `zekktris` user. The api
# constructs DATABASE_URL from it; you don't need to set DATABASE_URL.
DB_PASSWORD=change-me-to-a-long-random-string

# Max Postgres connections PER API PROCESS (10 under docker compose; 20 when
# the api runs outside it). This is a CLUSTER-WIDE
# budget: keep (replicas × DB_POOL_MAX) + a couple reserved for migrations/admin
# at or below Postgres `max_connections` (default 100). One replica → 20 is
# plenty; if you run several replicas, either lower this or raise the server's
# max_connections, or (recommended at scale) put pgBouncer in front and keep
# this small. Under pgBouncer transaction-pooling leave DB_PREPARED=false.
# DB_POOL_MAX=10

# ── Auth secrets ─────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32
# These two MUST differ from each other (>=32 chars each).
JWT_SECRET=replace-with-32-bytes-of-random-hex
JWT_REFRESH_SECRET=replace-with-different-32-bytes-of-random-hex

# Token lifetimes (seconds). Defaults are 15 minutes / 30 days.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ── Field encryption at rest (optional but recommended) ──────────────────────
# Encrypts sensitive columns at rest (TOTP 2FA secrets and bot event-signing
# secrets) with AES-256-GCM. Generate with:  openssl rand -hex 32
# MUST differ from the JWT secrets. Leave blank to store those fields in
# plaintext (the app still runs; a startup warning is logged).
#
# IMPORTANT: keep this key STABLE and backed up. If it's lost, already-
# encrypted secrets can't be recovered — affected users must re-enroll 2FA
# and bot owners must reset their event secret. After setting this for the
# first time on an EXISTING install, run once to encrypt old rows:
#   node scripts/encrypt-existing-secrets.mjs
FIELD_ENCRYPTION_KEY=replace-with-field-key-32-bytes-of-random-hex-or-leave-blank
# Key ROTATION: move the current key here (comma-separate several), put a new
# one in FIELD_ENCRYPTION_KEY, restart, then run the re-encrypt script
# (apps/api/scripts/reencrypt-fields.ts). Old keys are only used to decrypt.
# Drop one once the script has run — never before, or 2FA users are locked out.
# FIELD_ENCRYPTION_KEYS_OLD=

# ── Cookies ──────────────────────────────────────────────────────────────────
# COOKIE_SECURE controls whether the auth cookie is sent with `Secure`,
# which means browsers only return it over HTTPS. It MUST match PUBLIC_URL:
#   - PUBLIC_URL=https://...   → COOKIE_SECURE=true
#   - PUBLIC_URL=http://...    → COOKIE_SECURE=false   (the default)
#
# Mismatch breaks login silently — the browser drops the cookie and the
# next request looks unauthenticated. The default below pairs with the
# http:// PUBLIC_URL default; flip both when you go to TLS.
COOKIE_SECURE=false
# Optional. Leave blank to default to the request host.
# COOKIE_DOMAIN=

# ── Registration mode ────────────────────────────────────────────────────────
#   open         anyone can sign up
#   invite-only  signup requires an admin-issued code
#   closed       no signups; only admin-created accounts
ALLOW_REGISTRATION=open

# ── First admin ──────────────────────────────────────────────────────────────
# On boot, if NO user is an admin yet and a registered user has this email,
# that user is promoted to instance admin. Idempotent once any admin exists,
# so it is safe to leave set permanently.
#
# Set this to the address you will register with BEFORE first boot — it is the
# only way to get an admin without direct SQL access.
BOOTSTRAP_ADMIN_EMAIL=

# ── Account inactivity sweep (ON BY DEFAULT, DESTRUCTIVE) ────────────────────
# HARD-DELETES accounts that have not opened the app (refreshed a session) in
# this many days. Their messages stay, authored by "deleted user"; everything
# tied to the identity (sessions, memberships, DMs) goes. 0 turns it off.
# INACTIVITY_TTL_DAYS=365
# INACTIVITY_SWEEP_INTERVAL_HOURS=24

# ── Housekeeping sweeps (all on by default) ──────────────────────────────────
# "Your DM streak ends soon" notice, this many hours before the UTC-midnight
# reset.
# STREAK_WARN_ENABLED=true
# STREAK_WARN_HOURS_BEFORE=6
# Delete invites that expired or ran out of uses more than N days ago (they
# stay listed in the invite manager until then).
# INVITE_PRUNE_ENABLED=true
# INVITE_PRUNE_GRACE_DAYS=7
# Release parent/child supervision links once the child turns 18 (hygiene
# only — the release is enforced either way).
# PARENT_LINK_AGE_CHECK_ENABLED=true
# PARENT_LINK_AGE_CHECK_INTERVAL_HOURS=24

# ── Uploads ──────────────────────────────────────────────────────────────────
# Per-file limits the api enforces. Files live under ${APPDATA_PATH}/uploads.
MAX_UPLOAD_SIZE_MB=100
MAX_FILES_PER_MESSAGE=10
# Optional per-VIDEO cap in MB (0 = no separate cap; videos still bound by
# MAX_UPLOAD_SIZE_MB). A single large clip dwarfs hundreds of compressed
# images, so set this to reject oversized videos without lowering the overall
# limit. Rejects new uploads above it; never touches existing files.
# MAX_VIDEO_UPLOAD_SIZE_MB=0

# ── Media retention (ON BY DEFAULT, DESTRUCTIVE) ─────────────────────────────
# Ages out the FULL-SIZE bytes of attachments older than N days — the biggest
# long-term disk sink. Default 90 = ENABLED, and it really deletes (DRY_RUN
# defaults to false). Set ATTACHMENT_RETENTION_DAYS=0 to turn it off.
#
# It expires BLOBS, not messages. The message, its text, the attachment row
# (filename/size/dimensions) and the small thumbnail are all KEPT forever;
# clients show "original expired — thumbnail kept" instead of a broken image.
# Nothing is ever tombstoned by this sweep.
#
# ALWAYS skipped: pinned messages, thumbnail rows themselves, and any
# attachment with no surviving thumbnail (see REAP_UNTHUMBED below). E2EE
# channels ARE included — encrypted originals are the bulk of stored bytes, and
# their encrypted thumbnails are separate self-contained objects that keep
# decrypting fine once the original is gone.
#
# To PREVIEW before anything is deleted, set ATTACHMENT_RETENTION_DRY_RUN=true
# for one cycle — it logs candidates, reclaimable bytes and skip counts and
# touches nothing. Removing the bytes is irreversible — keep backups.
# ATTACHMENT_RETENTION_DAYS=90
# ATTACHMENT_RETENTION_DRY_RUN=true
#
# Opt-in, and a genuinely different trade: also expire originals that have NO
# thumbnail (attachments predating thumbnails, plus files/voice notes that never
# get one). For those the original is the ONLY copy, so this DESTROYS the image
# rather than downgrading it to a preview. With it off (default) the sweep skips
# them and reports how many / how many MB it left behind, so you can see exactly
# what you'd be trading before turning it on.
# ATTACHMENT_RETENTION_REAP_UNTHUMBED=false

# ── Image compression sweep ──────────────────────────────────────────────────
# Periodic background job that re-encodes image attachments older than 7
# days at a lower quality target — typically saves 30-50% on JPEG/WebP
# files without visible quality loss to the average viewer. PNGs get a
# lossless re-pack via maximum zlib + adaptive palette.
#
# REQUIRES the `sharp` npm package, which is intentionally NOT a hard
# dependency of the api because it carries a sizable native binary. If
# you want compression, install it inside the api container:
#
#   pnpm --filter @zekktris/api add sharp
#
# Without sharp installed the sweep still runs but no-ops gracefully —
# no errors, just a debug log entry per tick.
#
# IMAGE_COMPRESS_QUALITY (1-100): lossy quality target for JPEG/WebP.
#   Default 75 fits most communities. Photography-focused servers
#   typically want 85.
# IMAGE_COMPRESS_SWEEP_INTERVAL_HOURS: how often to run. Files don't
#   get older that fast; daily is plenty.
# IMAGE_COMPRESS_ENABLED: master off-switch (true/false).
IMAGE_COMPRESS_ENABLED=true
IMAGE_COMPRESS_QUALITY=75
IMAGE_COMPRESS_SWEEP_INTERVAL_HOURS=24

# ── Runtime ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Snowflake worker id (0..1023). Leave it EMPTY: each api process then leases a
# distinct id from Redis, which is what makes `--scale api=N` safe. A value here
# is handed to EVERY replica alike, and replicas sharing an id mint colliding
# ids. Set it only where each replica gets its own value.
# WORKER_ID=

# ── Redis ────────────────────────────────────────────────────────────────────
# docker compose always points the api at the bundled `cache` service
# (REDIS_URL=redis://cache:6379 in docker-compose.yml — not read from here). It
# carries the cross-replica event bus, worker-id leases, rate limits, session
# revocation and other short-lived state; nothing in it needs backing up. The
# api runs without it (in-memory, single process only) when REDIS_URL is unset
# outside compose.

# ── Voice / video (LiveKit) ─────────────────────────────────────────────────
# Voice/video uses LiveKit, and this stack BUNDLES its own LiveKit SFU (the
# `livekit` service in docker-compose.yml) that runs by default — so a
# standalone instance hosts its own voice with no external service.
#
# Turnkey self-hosted (the default):
#   - Leave LIVEKIT_WS_URL empty. The API hands clients a same-origin
#     wss://<your host>/livekit URL that Caddy proxies to the SFU, so voice
#     signaling rides your app's own host + TLS cert (no extra port to open).
#   - setup.sh generates LIVEKIT_API_KEY / LIVEKIT_API_SECRET for you. If you
#     fill the .env by hand, set any matching key + a 32+ char secret here;
#     the api and the livekit container must use the SAME pair.
#   - MEDIA needs reachable ports. The SFU runs on **host networking** (see
#     docker-compose.yml) so it binds UDP 7882 (primary) + TCP 7881 (fallback)
#     directly on this host. Same-LAN clients connect automatically via the
#     host's LAN IP; for clients off the LAN, open/forward UDP 7882 + TCP 7881
#     in the firewall/router. If a client can reach neither you'll see
#     "negotiation timed out" + an endless reconnect loop in voice.
#   - Advertised media IP: host networking already exposes the host LAN IP as
#     a candidate (fixes same-LAN calls). LIVEKIT_USE_EXTERNAL_IP=true also
#     STUN-discovers the public IP for remote clients. Only pin an address if
#     STUN misbehaves or you want a single fixed IP: set LIVEKIT_HOST to a
#     reachable IP AND LIVEKIT_USE_EXTERNAL_IP=false (both together — a pinned
#     IP is ignored while use-external-ip is true).
#   - Host networking needs Docker 20.10+ (unraid has it) for the
#     host.docker.internal gateway the api/Caddy use to reach the SFU.
#
# Prefer LiveKit Cloud instead? Set LIVEKIT_WS_URL to your wss://…livekit.cloud
# URL plus its key/secret; the bundled container then goes unused (stop it).
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# STUN-discover the public IP (true) or advertise LIVEKIT_HOST explicitly
# (false). Leave true unless pinning LIVEKIT_HOST below.
LIVEKIT_USE_EXTERNAL_IP=true
# Explicit media IP, only honored when LIVEKIT_USE_EXTERNAL_IP=false. Normally
# leave empty — host networking already advertises the host LAN IP.
LIVEKIT_HOST=
# Pin a specific LiveKit server image tag if needed (default v1.9).
LIVEKIT_IMAGE_TAG=v1.9.12
# Override only if the api/Caddy can't reach the SFU at the host gateway
# (e.g. you moved LiveKit off host networking). Default works on Docker 20.10+.
# LIVEKIT_HTTP_URL=http://host.docker.internal:7880
# Where the SFU's signalling/admin port 7880 listens. Nothing outside this
# machine needs it (browsers go through Caddy's /livekit), so by default it is
# bound to 127.0.0.1 + the Docker bridge address host.docker.internal points
# at — not the public interface. "all" restores every interface; or list
# addresses (comma-separated). Media ports 7881/7882 are not affected.
# LIVEKIT_BIND_ADDRESSES=

# ── Web Push (notifications) ─────────────────────────────────────────────────
# Optional. Without these, the Notifications tab in user settings shows a
# disabled state and no push events go out. The setup script auto-generates
# both keys on first run if they're empty.
#
# Generated by `npx web-push generate-vapid-keys` (or any web-push library
# that exports the VAPID key generation routine). Both pieces are
# inseparable — re-generating the public key invalidates every existing
# subscription, so don't change these once users have subscribed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email address shown to push gateways if they need to reach the
# operator about misuse. Required by the Web Push protocol; can be a
# distribution list rather than a person.
VAPID_CONTACT_EMAIL=

# ── APNs (native iOS push) ───────────────────────────────────────────────────
# Token-based Apple Push Notification service, used by the native iOS app
# (Web Push above does NOT work inside the Capacitor WKWebView, so iOS needs
# this instead). Leave blank to disable iOS push — the device-token endpoint
# returns 503 and sends are a no-op.
#
# Setup: developer.apple.com → Keys → "+" → enable "Apple Push Notifications
# service (APNs)" → download the .p8 ONCE (you can't re-download it). Note the
# Key ID shown on that page and your Team ID (top-right of the developer site).
#
# EASIEST SETUP (drag-and-drop): drop the downloaded AuthKey_<KEYID>.p8 into
# ./secrets/ (compose mounts it at /keys) and leave APNS_KEY_P8 + APNS_KEY_ID
# empty — the api finds the file and reads the Key ID from its name. You only
# need APNS_TEAM_ID + APNS_BUNDLE_ID below.
#
# Alternative: APNS_KEY_P8 takes the .p8 contents inline. Easiest is base64 so
# newlines survive an env file:  `base64 -i AuthKey_XXXX.p8`  (macOS) — paste
# the ONE-LINE output. Raw PEM (real newlines or \n escapes) is also accepted.
APNS_KEY_P8=
# Only needed if the .p8 file was renamed (normally read from the filename).
APNS_KEY_ID=
APNS_TEAM_ID=
# The app bundle id == the APNs topic.
APNS_BUNDLE_ID=com.zekktris.app
# "true" for TestFlight/App Store builds (production APNs host). Set to "false"
# ONLY when testing a debug build run directly from Xcode (sandbox host).
APNS_PRODUCTION=true

# ── Outbound email (SMTP) ────────────────────────────────────────────────────
# Used for password-reset emails. Missing SMTP_HOST or SMTP_FROM disables
# sending entirely — the password-reset endpoint will return 503 with a
# "this server hasn't enabled email" message.
#
# IMPORTANT: Cloudflare Email Routing is RECEIVE-ONLY. It forwards incoming
# mail at your domain (e.g. you@zekktris.com) to another inbox, but it
# cannot send outbound mail. To send password resets from your domain you
# need a real SMTP relay. Recommended:
#
#   Resend (https://resend.com)         — 3,000/month free, modern API
#     SMTP_HOST=smtp.resend.com
#     SMTP_USER=resend
#     SMTP_PASS=re_xxxxxxxxxxxx   (the API key from the dashboard)
#
#   Brevo (https://brevo.com)           — 300/day free
#     SMTP_HOST=smtp-relay.brevo.com
#     SMTP_USER=your-brevo-login@example.com
#     SMTP_PASS=the-smtp-key-from-brevo-dashboard
#
#   SendGrid (https://sendgrid.com)     — 100/day free
#     SMTP_HOST=smtp.sendgrid.net
#     SMTP_USER=apikey
#     SMTP_PASS=SG.xxxxxxxxx
#
# All of these support sending from your own domain (e.g. noreply@zekktris.com)
# once you add the verification DNS records they show you — DKIM + SPF, and
# optionally DMARC. Add them to Cloudflare DNS for the domain.
#
# SMTP_FROM is the From: header on outbound mail. Use an address on your
# verified sending domain (matches the DKIM/SPF records). For Resend with
# zekktris.com:    noreply@zekktris.com
#
# SMTP_SECURE: true for implicit TLS (port 465), false for STARTTLS (port
# 587, the modern default). Most providers list port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false


# ── Source code (AGPL-3.0) ───────────────────────────────────────────────────
# Zekktris is licensed under the GNU AGPL-3.0. If you run a MODIFIED version
# for other people, set this to where your changed source can be downloaded —
# the web app links to it. Leave blank when running it unmodified.
SOURCE_CODE_URL=

# ── Stripe — LEGACY, leave blank ─────────────────────────────────────────────
# Zekktris doesn't take payments: everything is free, and Scout / Guardian /
# Legend are perk tiers admins give out (Admin → Perks). These two exist only
# so a server that sold subscriptions before 2026-10-02 can wind them down.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
