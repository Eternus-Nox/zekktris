# syntax=docker/dockerfile:1.7
#
# Zekktris API
# -----------
# Two-stage build:
#   1. `deps` installs node_modules using only the workspace manifest files,
#      so the layer is cached unless package.json changes.
#   2. `runtime` brings the source in on top of those deps and uses tsx to
#      run TS directly. We avoid a tsc-output build step because Drizzle's
#      migrations folder + the workspace symlinks make output bundling more
#      finicky than it's worth at v1 scale, and tsx's startup cost is ~200ms
#      which is fine for a long-lived service.
#
# The container's CMD is just `node --import tsx/esm apps/api/src/index.ts`
# (resolved through pnpm). On boot, the API runs all startup checks
# inline — including database migrations — before binding the HTTP port.

# ─── Stage 1: dependency install ───────────────────────────────────────────
FROM node:20-alpine AS deps

# pnpm via corepack is the project's package manager; pin a known version so
# Docker rebuilds get the same resolver behavior over time.
ENV PNPM_VERSION=9.12.0
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

WORKDIR /app

# Copy ONLY the manifest files needed to resolve the workspace graph for the
# api app. Trying to be too clever with --filter installs and removing
# unrelated packages can leave broken peer deps; copying the relevant
# manifests and letting pnpm resolve normally is more reliable.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json

# --frozen-lockfile so a drift between the committed lockfile and these
# manifests fails the build loudly instead of silently solving differently.
RUN pnpm install --frozen-lockfile --filter @zekktris/api...

# ─── Stage 2: runtime image ────────────────────────────────────────────────
FROM node:20-alpine AS runtime

ENV PNPM_VERSION=9.12.0
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# Tini ensures signals (SIGTERM from `docker compose down`) reach the node
# process so the API's graceful shutdown handler runs and DB connections
# close cleanly.
RUN apk add --no-cache tini

WORKDIR /app

# Bring in the resolved node_modules and the workspace metadata.
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=deps /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=deps /app/tsconfig.base.json ./tsconfig.base.json

# Per-package symlinked node_modules (pnpm hoists across the workspace).
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules

# Source. We don't compile — tsx runs it directly. The migrations folder
# must ship alongside the migrate.ts file because the runner derives its
# path from import.meta.url.
COPY apps/api/package.json ./apps/api/package.json
COPY apps/api/src ./apps/api/src
COPY apps/api/tsconfig.json ./apps/api/tsconfig.json
COPY packages/db ./packages/db
COPY packages/shared ./packages/shared
COPY packages/tsconfig ./packages/tsconfig

# Default uploads target. Mounted as a volume in compose so attachments
# persist across container restarts.
RUN mkdir -p /data/uploads
ENV UPLOAD_DIR=/data/uploads

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
EXPOSE 3000

# tini → pnpm → tsx so SIGTERM propagates and shutdown is clean.
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["pnpm", "--filter", "@zekktris/api", "start"]

# Container health is /health on port 3000. The endpoint short-circuits the
# auth middleware and just returns {ok:true} once the server is listening.
# Use 127.0.0.1 (not 'localhost') because Node v17+ resolves localhost as
# IPv6 first, but the api binds to 0.0.0.0 (IPv4-only); without forcing
# IPv4 the healthcheck fails on systems where ::1 is preferred.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/health || exit 1
