{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env",
    "tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "generate": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "test": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "NODE_ENV",
        "UPLOAD_DIR",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "LIVEKIT_API_KEY",
        "LIVEKIT_API_SECRET",
        "LIVEKIT_WS_URL"
      ]
    }
  }
}
