# Zekktris Desktop release config — copy to `.env.release` (gitignored) and edit.
# release.sh sources this so you don't have to pass the publish target every run.

# ── Where to publish (pick ONE; SSH is the usual one for the Unraid host) ────
# rsync over SSH to the server's desktop-updates folder. This is the folder
# Caddy serves at https://<host>/desktop/updates/ (docker-compose mounts
# ${APPDATA_PATH}/desktop-updates there; APPDATA_PATH defaults to
# /mnt/user/appdata/zekktris on Unraid). Use an SSH key so it's non-interactive.
ZK_PUBLISH_SSH="root@TOWER_IP_OR_HOST:/mnt/user/appdata/zekktris/desktop-updates"

# …or publish to a locally-mounted share instead of SSH (comment out the SSH
# line above if you use this). e.g. the Unraid appdata share mounted in Finder:
# ZK_PUBLISH_DIR="/Volumes/appdata/zekktris/desktop-updates"

# ── Optional: ship the Android APK in the same publish ──────────────────────
# If set and the file exists, release.sh copies it to the update folder as
# Zekktris.apk, so the website's Android download button updates too.
# ZK_APK_PATH="$HOME/Desktop/zekktris/apps/web/android/app/build/outputs/apk/release/app-release.apk"

# ── Optional overrides (defaults shown) ─────────────────────────────────────
# CROSS=docker        # docker | wine | skip  — how to build Windows + Linux
# MAC_ARCH=universal  # universal | arm64 | x64
# MAC_SIGN=0          # 1 to code-sign + notarize macOS (needs an identity)
