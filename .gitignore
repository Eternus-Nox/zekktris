node_modules/
dist/
build/
.turbo/
*.log
.DS_Store
.env
.env.local
# install.sh keeps a copy of .env before changing it — same secrets.
.env.bak.*
xcuserdata/
DerivedData/
*.xcuserstate
Pods/
.build/

# IDE metadata (Android Studio / JetBrains) — machine-specific, never committed.
.idea/
# TypeScript incremental build cache — a build artifact, not source.
*.tsbuildinfo

# Local appdata (APPDATA_PATH=./data): live Postgres volume, Caddy certs, uploads.
/data/

# ── Server deployment: live data + artifacts + host-local files (never source) ──
# Live data / persisted volumes
/uploads/
/db/
/caddy-data/
/caddy-config/
# Backup bundles (the whole database, .env and the APNs key) and the host
# agent's request queue. They land in the repo whenever APPDATA_PATH is the
# repo itself (Unraid), and a bundle is as sensitive as the server.
/backups/
/control/
# restore.sh keeps the replaced .env alongside — same secrets as .env.
.env.before-restore-*
# Host-local state written by ops/livekit-wan-watchdog.sh.
/.livekit-wan.state
# Build / release artifacts served by the host
/desktop-updates/
/download/
desktop/updates/
desktop/package-lock.json
# Host-local deploy scaffolding (not part of the monorepo)
/src/
/static/
/tsconfig.json
/update.sh
/update.ps1
# Firebase client config for the Capacitor shell — optional there (its gradle
# skips the plugin when the file is absent), so it is supplied at build time.
# The native app's android-native/app/google-services.json IS committed on
# purpose: that build applies the google-services plugin unconditionally, and
# an Android Firebase client config is not a secret (see ANDROID_BUILD.md,
# "Push notifications").
apps/web/android/app/google-services.json
