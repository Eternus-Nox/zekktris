<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal launch screen for Zekktris: a solid navy (#050a18) background and
  NOTHING else — no logo, no image. iOS requires every app to have a launch
  screen, so it can't be removed outright, but a background-only screen that
  matches the app's own background reads as "no splash": you see a brief navy
  flash that blends straight into the app (whose WebView background is also
  #050a18 via capacitor.config ios.backgroundColor).

  Install: copy this over the generated one at
    apps/web/ios/App/App/Base.lproj/LaunchScreen.storyboard
  then in Xcode do Product -> Clean Build Folder and rebuild. (If you'd rather
  show the branded "Z" splash instead, don't use this file — run
  `cd apps/web` then the @capacitor/assets generator for iOS to build it from
  apps/web/assets/splash.png. See IOS_BUILD.md step 5.)
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="21701" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina6_12" orientation="portrait" appearance="dark"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21679"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <color key="backgroundColor" red="0.019607843137254902" green="0.039215686274509804" blue="0.09411764705882353" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <viewLayoutGuide key="safeArea" id="6Tk-OE-BBY"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ya1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
</document>
