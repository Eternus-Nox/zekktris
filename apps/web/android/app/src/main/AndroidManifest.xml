<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links: zekktris://… (matches the iOS URL scheme). Capacitor's
                 App plugin fires appUrlOpen; the web app routes the path into the
                 SPA (see useNativePush.ts navigateToTarget). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zekktris" />
            </intent-filter>

            <!-- HTTPS App Links: tapping https://<host>/… opens the app instead
                 of the browser. autoVerify requires a hosted
                 /.well-known/assetlinks.json with this app's SHA-256 signing
                 fingerprint (see ANDROID_BUILD.md) — until that's served +
                 verified, Android just offers the app in the chooser. Change the
                 host to match capacitor.config server.url before shipping. The
                 same navigateToTarget() routes the https path into the SPA. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="zekktris.com" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Push notifications (FCM). POST_NOTIFICATIONS is the Android 13+ runtime
         prompt the @capacitor/push-notifications plugin requests. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice / video calls. LiveKit runs as WebRTC inside the WebView via
         getUserMedia; the app must hold these so Capacitor's WebChromeClient
         can grant the WebView's mic/camera request. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
